      "duration": 6.216,
      "end": 84.638
    },
    {
      "idx": 16,
      "scene": 3,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "惊奇",
      "text": "窗户自己打开，风把小满的头发吹到脑后。他们从屋顶上飞过去，瓦片在脚下变成一片一片的鳞。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-2%",
        "pitch": "+7Hz",
        "volume": "+4%"
      },
      "gap_before": 0.32,
