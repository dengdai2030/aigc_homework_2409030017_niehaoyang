      "scene": 1,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "平静",
      "text": "晚上九点，妈妈关了灯，门轻轻合上。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-8%",
        "pitch": "+0Hz",
