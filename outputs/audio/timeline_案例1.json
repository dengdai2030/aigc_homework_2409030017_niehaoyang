      "duration": 4.32,
      "end": 4.47
    },
    {
      "idx": 1,
      "scene": 1,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "紧张",
      "text": "小满把自己缩成一个小球，只露出两只眼睛。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "+1%",
        "pitch": "+3Hz",
        "volume": "+0%"
      },
      "gap_before": 0.55,
      "start": 5.02,
      "duration": 4.44,
      "end": 9.46
    },
    {
      "idx": 2,
      "scene": 1,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "紧张",
      "text": "衣柜的影子像一只蹲着的猫，窗帘被风吹得鼓起来，又瘪下去。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "+1%",
        "pitch": "+3Hz",
        "volume": "+0%"
      },
      "gap_before": 0.32,
      "start": 9.78,
      "duration": 5.976,
      "end": 15.756
    },
    {
      "idx": 3,
      "scene": 1,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "低语",
      "text": "她在心里数：一、二、三……",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-24%",
        "pitch": "-3Hz",
        "volume": "-18%"
      },
      "gap_before": 0.55,
      "start": 16.306,
      "duration": 4.344,
      "end": 20.65
    },
    {
      "idx": 4,
      "scene": 1,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "紧张",
      "text": "数到七的时候，天花板上传来“咔哒”一声。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "+1%",
        "pitch": "+3Hz",
        "volume": "+0%"
      },
      "gap_before": 0.55,
      "start": 21.2,
      "duration": 4.104,
      "end": 25.304
    },
    {
      "idx": 5,
      "scene": 1,
      "speaker": "xiaoman",
      "speaker_name": "小满",
      "emotion": "低语",
      "text": "谁在那儿？",
      "voice": "zh-CN-XiaoyiNeural",
      "params": {
        "rate": "-18%",
        "pitch": "+1Hz",
        "volume": "-18%"
      },
      "gap_before": 0.55,
      "start": 25.854,
      "duration": 2.016,
      "end": 27.87
    },
    {
      "idx": 6,
      "scene": 1,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "平静",
      "text": "没有人回答。可她知道，这个家里除了她和妈妈，阁楼上还堆着外公留下的旧东西。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-8%",
        "pitch": "+0Hz",
        "volume": "+0%"
      },
      "gap_before": 0.55,
      "start": 28.42,
      "duration": 8.808,
      "end": 37.228
    },
    {
      "idx": 7,
      "scene": 2,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "平静",
      "text": "阁楼的楼梯在走廊尽头，第三级会响。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-8%",
        "pitch": "+0Hz",
        "volume": "+0%"
      },
      "gap_before": 1.0,
      "start": 38.228,
      "duration": 4.392,
      "end": 42.62
    },
    {
      "idx": 8,
      "scene": 2,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "紧张",
      "text": "小满踮着脚踩过去，还是“吱”了一声。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "+1%",
        "pitch": "+3Hz",
        "volume": "+0%"
      },
      "gap_before": 0.55,
      "start": 43.17,
      "duration": 3.504,
      "end": 46.674
    },
    {
      "idx": 9,
      "scene": 2,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "平静",
      "text": "灰尘在手电筒的光柱里慢慢地飘。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-8%",
        "pitch": "+0Hz",
        "volume": "+0%"
      },
      "gap_before": 0.55,
      "start": 47.224,
      "duration": 3.912,
      "end": 51.136
    },
    {
      "idx": 10,
      "scene": 2,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "平静",
      "text": "角落里躺着一只旧纸灯笼，竹骨撑得鼓鼓的，米白色的宣纸上打着两处补丁。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-8%",
        "pitch": "+0Hz",
        "volume": "+0%"
      },
      "gap_before": 0.32,
      "start": 51.456,
      "duration": 8.04,
      "end": 59.496
    },
    {
      "idx": 11,
      "scene": 2,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "惊奇",
      "text": "她伸手擦了擦，灯笼忽然“嗝”地响了一下。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-2%",
        "pitch": "+7Hz",
        "volume": "+4%"
      },
      "gap_before": 0.55,
      "start": 60.046,
      "duration": 3.864,
      "end": 63.91
    },
    {
