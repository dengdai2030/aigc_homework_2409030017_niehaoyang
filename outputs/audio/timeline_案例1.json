      "scene": 3,
      "speaker": "adeng",
      "speaker_name": "阿灯",
      "emotion": "兴奋",
      "text": "抓紧了！",
      "voice": "zh-CN-YunxiNeural",
      "params": {
        "rate": "+17%",
