      "idx": 18,
      "scene": 3,
      "speaker": "adeng",
      "speaker_name": "阿灯",
      "emotion": "温暖",
      "text": "你看，黑不是空的，黑是盖着被子的。",
      "voice": "zh-CN-YunxiNeural",
      "params": {
        "rate": "-3%",
        "pitch": "+3Hz",
        "volume": "+0%"
