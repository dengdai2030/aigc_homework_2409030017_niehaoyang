    {
      "idx": 13,
      "scene": 2,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "平静",
      "text": "一个细小的声音说。小满的手停在半空。灯笼里的火苗抖了抖，睁开了一只眼睛。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-8%",
