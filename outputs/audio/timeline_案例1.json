      "end": 77.872
    },
    {
      "idx": 15,
      "scene": 3,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "惊奇",
      "text": "阿灯说。它没有翅膀，可它飘起来的时候，整间阁楼都亮了。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-2%",
        "pitch": "+7Hz",
        "volume": "+4%"
      },
      "gap_before": 0.55,
