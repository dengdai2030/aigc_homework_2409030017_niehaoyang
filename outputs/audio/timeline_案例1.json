      "duration": 9.72,
      "end": 94.678
    },
    {
      "idx": 17,
      "scene": 3,
      "speaker": "narrator",
      "speaker_name": "旁白",
      "emotion": "温柔",
      "text": "整座城市正在关灯，一盏，两盏，三盏，像有人在数星星，只是数着数着就困了。",
      "voice": "zh-CN-XiaoxiaoNeural",
      "params": {
        "rate": "-19%",
        "pitch": "-1Hz",
        "volume": "-3%"
      },
      "gap_before": 0.55,
