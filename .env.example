# ============================================================
# 复制本文件为 .env 后填写。.env 已被 .gitignore 排除，不会进仓库。
# 不填任何东西也能跑：所有环节都有 replay / 本地降级方案。
# ============================================================

# ---------- 文本生成 ----------
# provider: replay（默认，回放 data/stories 下的样本）| openai（任意 OpenAI 兼容接口）
LLM_PROVIDER=replay
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 例：用智谱
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-plus

# ---------- 文生图 ----------
# provider: manifest（默认，取 outputs/images 已生成成品）| dashscope | openai
IMAGE_PROVIDER=manifest
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_API_KEY=
IMAGE_MODEL=wanx2.1-t2i-turbo

# ---------- 语音合成 ----------
# edge 免费，不需要 Key
TTS_PROVIDER=edge
